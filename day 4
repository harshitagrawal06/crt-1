//program-1
//rectangle shape in mumber

#include<iostream>
using namespace std;
int main(){
    for(int i=1; i<=3; i++){
        for(int j=1; j<=3; j++){
            cout<<j<<" ";
        }
        cout<<"\n";
    }
}

//program-2
//rectangle shape in 🌟 
#include<iostream>
using namespace std;
int main(){
    for(int i=1; i<=3; i++){
        for(int j=1; j<=3; j++){
            cout<<*<<" ";
        }
        cout<<"\n";
    }
}

